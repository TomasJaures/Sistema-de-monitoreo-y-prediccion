{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Sketch",
      "type": "process",
      "command": "C:\\Program Files\\Processing\\Processing.exe",
      "args": [
        "cli",
        "--force",
        {
          "value": "--sketch=${workspaceFolder}",
          "quoting": "strong"
        },
        {
          "value": "--output=${workspaceFolder}\\out",
          "quoting": "strong"
        },
        "--run"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
